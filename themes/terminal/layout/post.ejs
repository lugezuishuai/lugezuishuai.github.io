<article class="terminal-article">
  <div class="prompt-line"><span>$</span> cat <a href="<%- url_for('/') %>"><%- (page.source || page.slug + '.md') %></a></div>
  <header class="article-head">
    <h1><%- page.title || '*Untitled' %></h1>
    <div class="article-meta">
      <time datetime="<%- date_xml(page.date) %>"><%- date(page.date, theme.date_format) %></time>
      <% if (page.tags && page.tags.length) { %>
        <span>/</span>
        <% page.tags.each(function(tag) { %>
          <a href="<%- url_for(tag.path) %>">#<%- tag.name %></a>
        <% }); %>
      <% } %>
    </div>
  </header>
  <%
    var leadImage = page.featured_image || page.cover || '';
    if (leadImage && !/^(https?:)?\/\//.test(leadImage) && leadImage.charAt(0) !== '/') {
      var leadBase = (page.path || '').replace(/index\.html$/, '');
      if (leadBase && leadBase.charAt(leadBase.length - 1) !== '/') leadBase += '/';
      leadImage = leadBase + leadImage;
    }
  %>
  <% if (leadImage) { %>
    <figure class="article-cover">
      <img src="<%- url_for(leadImage) %>" alt="">
    </figure>
  <% } %>
  <div class="terminal-content">
    <%- page.content %>
  </div>
  <%
    var previousSeriesPost = null;
    var nextSeriesPost = null;

    if (page.series && site.posts && site.posts.toArray) {
      var seriesPosts = site.posts.toArray()
        .filter(function(post) {
          return post.series === page.series && post.series_order !== undefined;
        })
        .sort(function(firstPost, secondPost) {
          return Number(firstPost.series_order) - Number(secondPost.series_order);
        });
      var currentSeriesIndex = seriesPosts.findIndex(function(post) {
        return post.path === page.path;
      });

      if (currentSeriesIndex > 0) {
        previousSeriesPost = seriesPosts[currentSeriesIndex - 1];
      }
      if (currentSeriesIndex >= 0 && currentSeriesIndex < seriesPosts.length - 1) {
        nextSeriesPost = seriesPosts[currentSeriesIndex + 1];
      }
    }
  %>
  <% if (previousSeriesPost || nextSeriesPost) { %>
    <nav class="series-navigation" aria-label="<%- page.series %>系列文章导航">
      <div class="series-navigation-slot">
        <% if (previousSeriesPost) { %>
          <a class="series-navigation-link series-navigation-previous" href="<%- url_for(previousSeriesPost.path) %>">
            <span class="series-navigation-label">&lt; 上一章</span>
            <strong><%- previousSeriesPost.title %></strong>
          </a>
        <% } %>
      </div>
      <div class="series-navigation-slot series-navigation-next-slot">
        <% if (nextSeriesPost) { %>
          <a class="series-navigation-link series-navigation-next" href="<%- url_for(nextSeriesPost.path) %>">
            <span class="series-navigation-label">下一章 &gt;</span>
            <strong><%- nextSeriesPost.title %></strong>
          </a>
        <% } %>
      </div>
    </nav>
  <% } %>
</article>
